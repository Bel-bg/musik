# ==========================================
# 1. Spécifique à Tauri (Rust / Cargo)
# ==========================================
# Dossier de build principal de Rust
src-tauri/target/

# Fichiers temporaires ou de verrouillage générés par Cargo
src-tauri/Cargo.lock

# Si vous utilisez des variables d'environnement côté Rust
src-tauri/.env
src-tauri/.env.*

# ==========================================
# 2. Spécifique à React + Vite (Node / Frontend)
# ==========================================
# Dépendances Node
node_modules/
jspm_packages/

# Dossiers de build frontend (générés par Vite)
dist/
dist-ssr/
build/
.tours

# Logs de plantage ou de debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Fichiers de configuration locale / Variables d'environnement
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache de Vite, TypeScript et des frameworks associés
.vite/
.eslintcache
.stylelintcache
.tsbuildinfo

# ==========================================
# 3. Fichiers Système et Éditeurs (OS / IDE)
# ==========================================
# Fichiers système Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Fichiers système macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes
*.icloud

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# IntelliJ / WebStorm / RustRover (JetBrains)
.idea/
*.iws
*.iml
*.ipr

# Éditeurs de texte divers
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
